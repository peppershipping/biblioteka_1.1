# Скопируйте в .env (docker compose читает backend/.env)
APP_ENV=development
DATABASE_URL=postgresql+psycopg://biblioteka:biblioteka@db:5432/biblioteka
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
LOG_LEVEL=INFO
DOCS_ENABLED=true

# Администратор (создаётся при первом запуске, если задан полный набор)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# Демо-каталог из 23 книг (только если каталог пуст)
SEED_DEMO_DATA=true

# Кэш (необязательно: без Redis всё работает, читается напрямую из PostgreSQL)
REDIS_URL=redis://redis:6379/0

# ИИ-пояснения к рекомендациям и умный поиск (необязательно).
# Подойдёт любой API, совместимый с Chat Completions.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
